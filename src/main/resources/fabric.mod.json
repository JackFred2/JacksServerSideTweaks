{
	"schemaVersion": 1,
	"id": "jsst",
	"version": "${version}",
	"name": "Jack's Server Side Tweaks",
	"description": "A collection of server-side quality of life tweaks and survival friendly tools.",
	"authors": [
		"JackFred"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/jsst/",
		"issues": "https://github.com/JackFred2/JacksServerSideTweaks/issues",
		"sources": "https://github.com/JackFred2/JacksServerSideTweaks/"
	},
	"license": "ARR",
	"icon": "assets/jsst/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"red.jackf.jsst.impl.JSST"
		],
		"client": [
			"red.jackf.jsst.client.impl.JSSTClient"
		],
		"modmenu": [
			"red.jackf.jsst.client.impl.compat.JSSTModMenu"
		]
	},
	"mixins": [
		"jsst.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.5",
		"minecraft": ">=${mcVersion}",
		"java": ">=${javaRequirement}",
		"yet_another_config_lib_v3": ">=3.6.0",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/jsst",
				"modmenu.github_releases": "https://github.com/JackFred2/JacksServerSideTweaks/releases",
				"modmenu.kofi": "https://ko-fi.com/jackfred",
				"modmenu.wiki": "https://docs.jackf.red/jsst/"
			}
		}
	}
}